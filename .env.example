# commentToFix backend configuration.
# Copy to .env for local overrides (git-ignored). Real env vars always win.
# Every value below shows its default; uncomment to change.

# ---- database ----------------------------------------------------------------
# SQLite path; ':memory:' for an ephemeral run.
#CTF_DB=data/ctf.db

# ---- agent queue --------------------------------------------------------------
# Max concurrent agent runs (extra tasks wait in the FIFO queue).
#AGENT_MAX_INFLIGHT=2
# Deliveries before a task lands in the dead-letter queue.
#TASK_MAX_ATTEMPTS=3
# Worker lease horizon; an expired lease marks the worker dead.
#TASK_LEASE_S=15
# Janitor sweep cadence reclaiming orphaned tasks (demo: 30; prod: ~1800).
#REAPER_INTERVAL_S=30
# Hard per-attempt deadline for a hung (still-heartbeating) worker.
#TASK_TIMEOUT_S=300
# Which task launcher runs the work (see backend/agent/launchers/).
#AGENT_LAUNCHER=fake-claude

# ---- comment rate limit (per user, sliding window) -----------------------------
#RATE_LIMIT_MAX=8
#RATE_LIMIT_WINDOW_S=30

# ---- api ----------------------------------------------------------------------
# Comma-separated allowed origins for CORS.
#CORS_ORIGINS=http://localhost:3000

# ---- logging ------------------------------------------------------------------
#LOG_LEVEL=INFO
# text | json (json for log shippers)
#LOG_FORMAT=text

# ---- real PR integration (optional) --------------------------------------------
# When GITHUB_TOKEN + GITHUB_REPO are set (and PR_SERVICE is auto), approving a
# preview opens a REAL pull request on that repo and merge squash-merges it
# (merge commits are tagged [skip render] so demo merges don't redeploy).
# PR_SERVICE: auto | fake | github
#PR_SERVICE=auto
#GITHUB_REPO=totorohxms/comment-to-fix
# Set the token YOURSELF and never commit it. Fine-grained PAT scoped to the
# repo with Contents: read/write + Pull requests: read/write.
#GITHUB_TOKEN=
#GITHUB_AUTO_MERGE=1
# Absolute base for preview links inside PR bodies.
#APP_BASE_URL=https://commenttofix.onrender.com

# ---- metrics (statsd over UDP; fire-and-forget) --------------------------------
#STATSD_HOST=127.0.0.1
#STATSD_PORT=8125
#STATSD_PREFIX=ctf
#STATSD_ENABLED=1
